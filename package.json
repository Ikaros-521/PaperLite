{
  "name": "paperlite",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "PaperLite · 论文速写编辑器（LaTeX 实时预览 / TikZ 流程图 / 导出 PDF）",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/texlive-manifest.mjs --check",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node test/smoke.mjs && node test/editorTools.mjs && node test/findModel.mjs && node test/history.mjs && node test/compileProject.mjs && node test/reviewRegressions.mjs && node test/fileTree.mjs && node test/documentSafety.mjs && node test/chatContext.mjs",
    "test:xelatex": "node scripts/texlive-manifest.mjs --check && node test/xelatex.mjs",
    "tex:manifest": "node scripts/texlive-manifest.mjs",
    "tex:warm": "node scripts/texlive-manifest.mjs --check && node test/xelatex.mjs --write-warm"
  },
  "dependencies": {
    "antd-mobile": "^5.43.0",
    "antd-mobile-icons": "^0.3.0",
    "codemirror": "^5.65.16",
    "diff": "^8.0.4",
    "katex": "^0.18.2",
    "markdown-it": "^15.0.2",
    "mermaid": "^10.9.3",
    "pdfjs-dist": "^5.4.624",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11"
  },
  "overrides": {
    "katex": "$katex"
  },
  "license": "GPL-3.0-or-later"
}
